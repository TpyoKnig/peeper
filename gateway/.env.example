# Copy to `.env` and run: node --env-file=.env server.mjs
# nod's address. Its host must match nod's NOD_PUBLIC_URL exactly (nod rejects other Host headers).
NOD_URL=http://127.0.0.1:4310
# nod's owner token (nod's NOD_AUTH_TOKEN). Stays on this machine; glasses never see it.
NOD_AUTH_TOKEN=
# Where the glasses connect. Use the Mac's LAN IP so the phone can reach it.
HOST=192.168.1.10
PORT=8787
# Pairing admin API (pair.mjs). Always bound to 127.0.0.1.
ADMIN_PORT=8788
